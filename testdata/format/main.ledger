; Explains the account below.
account Assets:Bank:ZKB
 ; ZKB is a bank in Zürich.
 alias  Bank

include  sub/*.ledger

apply tag  foo
apply tag  bar:  baz
end  apply  tag
end apply tag


2024/1/2 Grocery
  Expenses:Grocery   12.30 CHF
  Assets:Bank:ZKB
